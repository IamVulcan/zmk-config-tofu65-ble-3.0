/*
 * Tofu65 3.0 BLE ANSI user keymap: KBD67 Lite VIA migration
 *
 * PLACE IN: config/tofu65_ble_v3_ansi.keymap
 * UPSTREAM: https://github.com/faytahl/zmk-config-tofu65-ble-3.0
 * TARGET: board klink + shield tofu65_ble_v3_ansi
 *
 * Maintains four VIA layers: Base, Function, Numpad, Unused.
 * Replaces old RGB controls in Layer 1 with BT profile and Studio controls.
 * The VIA custom keycode 0x5cde (Function+Enter) remains inactive.
 *
 * The Tofu65 3.0 ANSI firmware expects 69 matrix positions for this layout.
 * There are two unused split-key positions, #13 and #46 (zero-based),
 * corresponding to optional split Backspace and optional split Left Shift.
 * They MUST remain as &none entries to keep the physical mapping aligned.
 *
 * Built for the community klink/tofu65_ble_v3_ansi configuration.
 * Verify actual keys after flashing; the new version is not yet test-flashed.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define L_BASE 0
#define L_FUNCTION 1
#define L_NUMPAD 2
#define L_UNUSED 3

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
                /* Row 0 */ &gresc                &kp N1                &kp N2                &kp N3                &kp N4                &kp N5                &kp N6                &kp N7                &kp N8                &kp N9                &kp N0                &kp MINUS             &kp EQUAL             &none                 &kp BACKSPACE         &kp DELETE
                /* Row 1 */ &kp TAB               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp LEFT_BRACKET      &kp RIGHT_BRACKET     &kp BACKSLASH         &kp END
                /* Row 2 */ &kp CAPSLOCK          &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp SEMICOLON         &kp SINGLE_QUOTE      &kp ENTER             &kp PAGE_DOWN
                /* Row 3 */ &kp LEFT_SHIFT        &none                 &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &kp N                 &kp M                 &kp COMMA             &kp PERIOD            &kp SLASH             &kp RIGHT_SHIFT       &kp UP                &mo 1
                /* Row 4 */ &kp LEFT_CONTROL      &kp LEFT_GUI          &kp LEFT_ALT          &kp SPACE             &mo 2                 &kp RIGHT_CONTROL     &kp LEFT              &kp DOWN              &kp RIGHT
            >;
        };

        layer_1 {
            display-name = "Function";
            bindings = <
                /* Row 0 */ &gresc                &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                &kp F6                &kp F7                &kp F8                &kp F9                &kp F10               &kp F11               &kp F12               &none                 &kp N1                &kp HOME
                /* Row 1 */ &trans                &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &bt BT_CLR            &studio_unlock        &bt BT_NXT            &bt BT_PRV            &kp PRINTSCREEN       &kp SCROLLLOCK        &kp PAUSE_BREAK       &bootloader           &kp PAGE_UP
                /* Row 2 */ &trans                &none                 &none                 &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &none                 &kp PAGE_DOWN
                /* Row 3 */ &kp LEFT_SHIFT        &none                 &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &kp INSERT            &none                 &trans
                /* Row 4 */ &trans                &trans                &trans                &trans                &trans                &trans                &none                 &none                 &none
            >;
        };

        layer_2 {
            display-name = "Numpad";
            bindings = <
                /* Row 0 */ &trans                &kp KP_N1             &kp KP_N2             &kp KP_N3             &kp KP_N4             &kp KP_N5             &kp KP_N6             &kp KP_N7             &kp KP_N8             &kp KP_N9             &kp KP_N0             &trans                &trans                &none                 &trans                &kp INSERT
                /* Row 1 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 2 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 3 */ &trans                &none                 &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 4 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };

        layer_3 {
            display-name = "Unused";
            bindings = <
                /* Row 0 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &none                 &trans                &trans
                /* Row 1 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 2 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 3 */ &trans                &none                 &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
                /* Row 4 */ &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans                &trans
            >;
        };
    };
};
